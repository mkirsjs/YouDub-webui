+  return {
+    headers: headersWithHost(request.headers, origin.hostHeader),
+    secure: origin.protocol === 'https:',
+    trustedHosts: [...options.trustedHosts, origin.trustedAuthority],
+    protocol: origin.protocol,
+    proxied: true,
+  }
+}
