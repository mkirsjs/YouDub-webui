+
+def _prior_wavs(task_root: Path, destination: Path) -> list[Path]:
+    attempts = task_root / "attempts"
+    if not attempts.is_dir():
+        return []
+    found = []
+    for path in attempts.glob("*/*/tts/*.wav"):
